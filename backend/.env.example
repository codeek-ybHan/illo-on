# 일로ON 백엔드 환경변수 예시
# 실제 값은 셸 환경변수로 주입하거나 IDE 실행 구성에 설정
# (Spring Boot 는 .env 를 자동 로드하지 않음 — export 하거나 --spring-boot.run.jvmArguments 사용)

# ── AI ──────────────────────────────────────────
# mock: OpenAI 없이 규칙 기반 분석 (기본, 데모 가능)
# openai: Spring AI + OpenAI (아래 키 필요)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# ── 보안 ────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# ── 프론트 초대 링크 베이스 ─────────────────────
INVITE_BASE_URL=http://localhost:5173/invite/

# ── 운영 DB (profile=prod) ──────────────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=illo_on
# DB_USER=illoon
# DB_PASSWORD=
