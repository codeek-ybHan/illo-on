# docker compose 배포용 환경변수.  `cp .env.example .env` 후 값을 채우세요.
# (.env 는 git 에 커밋되지 않습니다)

# 서버 공개 주소 — 초대 링크에 사용. front 를 80 포트로 매핑하면 http://<서버IP>
APP_BASE_URL=http://localhost:5173

# JWT 서명 키 — 반드시 긴 랜덤 문자열로 교체  (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-________________________________

# MySQL 비밀번호 (공개 서버면 반드시 교체)
DB_PASSWORD=illoon
DB_ROOT_PASSWORD=root

# AI 분석 — openai 로 켜려면 provider 를 openai 로 바꾸고 키를 넣으세요. 비우면 규칙 기반(mock).
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
