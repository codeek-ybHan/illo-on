# 일로ON · Caddy 리버스 프록시
#   - Let's Encrypt 인증서를 자동 발급/갱신 (인증서는 caddy-data 볼륨에 저장)
#   - TLS 를 종료하고 front(nginx) 컨테이너로 평문 프록시
#   - front(nginx) 가 SPA 라우팅 + /api → backend:8080 프록시를 그대로 담당
#
# 전제: DNS A 레코드 illo-on.site / www.illo-on.site → 서버 공개 IP,
#       Cloudflare 프록시는 "DNS only"(회색 구름), 서버 방화벽에 80·443 인바운드 허용.

illo-on.site {
	encode zstd gzip
	reverse_proxy front:80
}

# www 로 들어오면 apex 로 영구 리다이렉트 (www DNS 레코드가 있어야 인증서 발급됨)
www.illo-on.site {
	redir https://illo-on.site{uri} permanent
}
